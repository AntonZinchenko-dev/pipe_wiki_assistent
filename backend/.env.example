# Скопировать в .env и поправить под себя.

# --- Провайдер по умолчанию -------------------------------------------------
# Порядок деградации: сначала первый, при отказе — следующий (раздел 2).
PW_PROVIDER_CHAIN=ollama

# --- Ollama (локальный контур) ----------------------------------------------
PW_OLLAMA_URL=http://127.0.0.1:11434
# Версии моделей заданы ЯВНО, без latest: алиас в проде — приглашение к
# сюрпризам (раздел 7). Если у вас в `ollama list` тег latest — впишите его,
# но знайте, что за ним может поехать модель.
PW_OLLAMA_CHAT_MODEL=qwen2.5:14b
PW_OLLAMA_EMBED_MODEL=bge-m3:latest
PW_OLLAMA_EMBED_DIM=1024

# Судья для измерений. Обязательно ДРУГАЯ модель, чем отвечающая: модель,
# проверяющая свои же ответы, систематически их одобряет (раздел 4).
PW_JUDGE_MODEL=nemotron-3.5-lightning:latest
# Размышления у судьи. false — выключить: судье они не нужны (у него есть поле
# reason), а включённые съедают лимит токенов до начала ответа, и наружу
# приходит пустой вердикт.
PW_JUDGE_THINK=false
PW_JUDGE_MAX_TOKENS=700

# --- GigaChat (облачный резерв, включается на шаге про провайдеров) ---------
PW_GIGACHAT_ENABLED=false
PW_GIGACHAT_AUTH_KEY=
PW_GIGACHAT_SCOPE=GIGACHAT_API_PERS
PW_GIGACHAT_MODEL=GigaChat
PW_GIGACHAT_CA_BUNDLE=./certs/russian_root.cer
PW_AGENT_ENABLED=true
PW_FATIGUE_API_URL=http://127.0.0.1:8100
# --- Генерация ---------------------------------------------------------------
# Ноль для извлечения и структурированного ответа: нам нужна
# предсказуемость, а не разнообразие формулировок (раздел 1).
PW_TEMPERATURE=0
PW_MAX_ANSWER_TOKENS=700
PW_CONTEXT_TOKEN_BUDGET=3200

# --- Поиск -------------------------------------------------------------------
PW_SEARCH_TOP_K=24
PW_CONTEXT_MAX_FRAGMENTS=8
# Абсолютный порог косинуса: ниже — считаем, что релевантного в базе нет, и
# честно отвечаем «не найдено» вместо контекста из мусора (раздел 3).
# Значение ОБЯЗАНО быть откалибровано на золотом наборе — это шаг 2.
PW_SIMILARITY_FLOOR=0.45
PW_RRF_K=60

# --- Лимиты и таймауты (раздел 7) -------------------------------------------
PW_REQUEST_TIMEOUT_S=120
PW_CONNECT_TIMEOUT_S=5
PW_STREAM_IDLE_TIMEOUT_S=45
PW_RATE_LIMIT_RPM=30
PW_RATE_LIMIT_TPM=60000

# --- Пути --------------------------------------------------------------------
PW_CORPUS_DIR=../corpus
PW_DB_PATH=./var/pipewiki.sqlite3
PW_TRACE_DIR=./var/traces


PW_PROMPT_NAME=wiki-answer-2.0